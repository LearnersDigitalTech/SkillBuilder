generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  phoneNumber   String?   @unique
  passwordHash  String?
  userType      UserType  @default(PARENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  children      Child[]
  teacherProfile TeacherProfile?
  
  @@index([email])
  @@index([phoneNumber])
  @@map("users")
}

model Child {
  id            String    @id @default(uuid())
  name          String
  grade         String
  school        String?
  parentId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  parent        User      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  quizResults   QuizResult[]
  speedTests    SpeedTest[]
  
  @@index([parentId])
  @@index([grade])
  @@map("children")
}

model QuizResult {
  id            String    @id @default(uuid())
  childId       String
  grade         String
  score         Int
  totalQuestions Int
  timeSpent     Int
  answers       Json
  learningPlan  String?   @db.Text
  createdAt     DateTime  @default(now())
  
  child         Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  
  @@index([childId])
  @@index([createdAt])
  @@map("quiz_results")
}

model TeacherProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  name          String
  school        String?
  assignedGrades String[]
  assignedStudents Json?
  permissions   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("teacher_profiles")
}

model SpeedTest {
  id            String    @id @default(uuid())
  childId       String
  childName     String
  grade         String
  score         Int
  level         Int
  timeSpent     Int
  createdAt     DateTime  @default(now())
  
  child         Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  
  @@index([childId])
  @@index([score])
  @@index([createdAt])
  @@map("speed_tests")
}

model LotteryRegistration {
  id            String    @id @default(uuid())
  ticketCode    String    @unique
  teacherName   String
  email         String
  phoneNumber   String
  school        String?
  createdAt     DateTime  @default(now())
  
  @@index([ticketCode])
  @@index([email])
  @@map("lottery_registrations")
}

enum UserType {
  PARENT
  STUDENT
  TEACHER
  ADMIN
}
