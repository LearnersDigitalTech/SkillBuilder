{
    "name": "skillbuilder-backend",
    "version": "1.0.0",
    "description": "SkillBuilder Backend API",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "migrate": "prisma migrate dev",
        "migrate:deploy": "prisma migrate deploy",
        "seed": "ts-node prisma/seed.ts",
        "studio": "prisma studio",
        "test": "jest",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "express": "^4.18.2",
        "@prisma/client": "^5.8.0",
        "jsonwebtoken": "^9.0.2",
        "bcrypt": "^5.1.1",
        "zod": "^3.22.4",
        "socket.io": "^4.7.2",
        "redis": "^4.6.12",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "express-rate-limit": "^7.1.5",
        "morgan": "^1.10.0",
        "dotenv": "^16.3.1",
        "express-validator": "^7.0.1",
        "multer": "^1.4.5-lts.1",
        "compression": "^1.7.4"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.6",
        "@types/bcrypt": "^5.0.2",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/cors": "^2.8.17",
        "@types/morgan": "^1.9.9",
        "@types/compression": "^1.7.5",
        "typescript": "^5.3.3",
        "ts-node-dev": "^2.0.0",
        "ts-node": "^10.9.2",
        "prisma": "^5.8.0",
        "jest": "^29.7.0",
        "@types/jest": "^29.5.11",
        "supertest": "^6.3.3",
        "@types/supertest": "^6.0.2"
    }
